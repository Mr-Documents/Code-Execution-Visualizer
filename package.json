{
  "name": "code-execution-visualizer",
  "displayName": "Code Execution Visualizer",
  "description": "Step through JavaScript execution line-by-line with live variable, call stack, and memory visualization.",
  "version": "0.1.0",
  "publisher": "YOUR_PUBLISHER_ID",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_GITHUB_USERNAME/code-execution-visualizer.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_GITHUB_USERNAME/code-execution-visualizer/issues"
  },
  "homepage": "https://github.com/YOUR_GITHUB_USERNAME/code-execution-visualizer#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Debuggers",
    "Education",
    "Visualization"
  ],
  "keywords": [
    "debugger",
    "visualization",
    "execution",
    "javascript",
    "python",
    "learning",
    "call stack",
    "step-through"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-execution-visualizer.start",
        "title": "Visualize Execution",
        "icon": "$(play)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "build:webview": "cd webview-ui && npm run build",
    "install:all": "npm install && cd webview-ui && npm install",
    "test:tracer": "node --test test/tracer.test.js test/python-tracer.test.js",
    "test:webview": "cd webview-ui && npm test",
    "test": "npm run test:tracer && npm run test:webview"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "copy-webpack-plugin": "^14.0.0",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1"
  }
}
